# Mafia42 Collection Journal Environment Variables

# Application
APP_NAME="Mafia42 Collection Journal"

# Database Configuration (PostgreSQL for Production, SQLite for Local)
DATABASE_URL=sqlite:///./mafia42.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/mafia42_journal

# Security Secrets
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Initial Owner / Administrator Account (Provisioned on first deployment boot)
INITIAL_OWNER_EMAIL=owner@mafia42journal.com
INITIAL_OWNER_USERNAME=Owner
INITIAL_OWNER_PASSWORD=ChangeThisPasswordOnFirstLogin2026!

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000", "http://127.0.0.1:8000"]

