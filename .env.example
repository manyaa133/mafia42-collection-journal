# Mafia42 Collection Journal — Environment Variables
# Copy this file to .env for local development (never commit .env to git)

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Mafia42 Collection Journal"

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (default):
DATABASE_URL=sqlite:///./mafia42.db

# Production PostgreSQL (Supabase or Render):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ── Initial Owner / Administrator Account ────────────────────────────────────
# Provisioned automatically on first app startup if no owner exists.
# CHANGE THE PASSWORD immediately after first login!
INITIAL_OWNER_EMAIL=owner@mafia42journal.com
INITIAL_OWNER_USERNAME=Owner
INITIAL_OWNER_PASSWORD=ChangeThisPasswordOnFirstLogin2026!

# ── CORS Allowed Origins ──────────────────────────────────────────────────────
# Local dev:
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# Production (replace with your actual Render URL):
# CORS_ORIGINS=["https://mafia42-collection-journal.onrender.com"]
